# =============================================================================
# LOCAL (docker compose up -d)
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/phuonglily?schema=public"
DATABASE_URL_UNPOOLED="${DATABASE_URL}"

# NextAuth (admin) + chữ ký phiên học viên
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3001"

# Admin seed
ADMIN_EMAIL="admin@phuonglilyacademy.com"
ADMIN_PASSWORD="admin123"

# Hiện mã OTP trên màn hình khi chưa cấu hình SMTP (chỉ dùng để chạy thử production)
SHOW_OTP_ON_SCREEN="false"

# Gmail SMTP. Nếu Admin → Thiết lập chưa lưu email/mật khẩu, site dùng hai biến này.
MAILER_EMAIL=""
MAILER_APP_PASSWORD=""

# -----------------------------------------------------------------------------
# Upstash Redis (https://console.upstash.com) — cache + rate limit
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_KEY_PREFIX="pl"
REDIS_CACHE_TTL="300"

# -----------------------------------------------------------------------------
# Vercel Blob (file upload trên production)
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# SePay cổng thanh toán. sandbox cho tới khi chuyển Production trên my.sepay.vn
SEPAY_ENV="sandbox"
SEPAY_MERCHANT_ID=""
SEPAY_SECRET_KEY=""

# =============================================================================
# VERCEL PRODUCTION (Project → Settings → Environment Variables)
# =============================================================================
# DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require
# AUTH_SECRET=...
# AUTH_URL=https://your-domain.vercel.app
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# SHOW_OTP_ON_SCREEN=true   (tắt sau khi cấu hình SMTP trong Admin → Thiết lập)
